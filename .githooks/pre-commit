#!/usr/bin/env bash
#
# Checks the commit identity, then runs the workstation checks on the staged changes.
# The workstation checks are configured outside the repository and fail closed when absent.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
"${root}/.githooks/identity-guard.sh" config
checks="$(git config --get workstation.checks || true)"
[[ -x "${checks}" ]] || { echo 'pre-commit: workstation checks are not configured' >&2; exit 1; }
exec "${checks}" pre-commit "${root}"
